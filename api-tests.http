# Manual API tests for the VS Code "REST Client" extension.
# Click "Send Request" above a request to run it.
# Passwords come from .env via {{$dotenv ...}}, so no secret is ever written in this file.

@baseUrl = http://localhost:8080/api
@adminToken = {{adminLogin.response.body.accessToken}}
@customerToken = {{customerLogin.response.body.accessToken}}

### Log in as admin (run this first; the token lasts 15 minutes)
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}"
}

### Log in as a demo customer (public demo password, see docs/demo-accounts.md)
# @name customerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "lina.haddad@example.com",
  "password": "Demo@2026"
}


########## ForgeAI: compatibility check (open to guests, no token) ##########

### Sara's demo build (V5): compatible and complete
POST {{baseUrl}}/forge/check
Content-Type: application/json

{
  "items": [
    { "productId": 1,   "quantity": 1 },
    { "productId": 69,  "quantity": 1 },
    { "productId": 77,  "quantity": 1 },
    { "productId": 31,  "quantity": 1 },
    { "productId": 89,  "quantity": 1 },
    { "productId": 117, "quantity": 1 },
    { "productId": 122, "quantity": 1 },
    { "productId": 134, "quantity": 1 }
  ]
}

### Same build in a small SFX-only case: CASE_SIZE, PSU_SIZE and more
POST {{baseUrl}}/forge/check
Content-Type: application/json

{
  "items": [
    { "productId": 1,   "quantity": 1 },
    { "productId": 69,  "quantity": 1 },
    { "productId": 77,  "quantity": 1 },
    { "productId": 31,  "quantity": 1 },
    { "productId": 89,  "quantity": 1 },
    { "productId": 117, "quantity": 1 },
    { "productId": 131, "quantity": 1 },
    { "productId": 134, "quantity": 1 }
  ]
}

### Live builder, first two parts: AM5 CPU + LGA1700 board -> SOCKET error, rest listed as missing
POST {{baseUrl}}/forge/check
Content-Type: application/json

{ "items": [ { "productId": 1, "quantity": 1 }, { "productId": 60, "quantity": 1 } ] }

### Empty build (the builder's starting point)
POST {{baseUrl}}/forge/check
Content-Type: application/json

{ "items": [] }


########## Admin products ##########

### List all products, hidden ones too (same filters as the store)
GET {{baseUrl}}/admin/products?size=5
Authorization: Bearer {{adminToken}}

### Only hidden products (active=true shows only visible ones)
GET {{baseUrl}}/admin/products?active=false
Authorization: Bearer {{adminToken}}

### One product with its specs
GET {{baseUrl}}/admin/products/1
Authorization: Bearer {{adminToken}}

### Create a CPU (expect 201; run it twice to see 409 for the duplicate SKU)
# @name createdProduct
POST {{baseUrl}}/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "TEST-CPU-001",
  "name": "Test CPU 9000",
  "brand": "TestBrand",
  "description": "Created from api-tests.http",
  "price": 199.99,
  "stockQuantity": 5,
  "categorySlug": "processors",
  "productType": "CPU",
  "warrantyMonths": 36,
  "performanceScore": 70,
  "specs": {
    "kind": "CPU",
    "socket": "AM5",
    "cores": 8,
    "threads": 16,
    "baseClockGhz": 4.2,
    "boostClockGhz": 5.0,
    "tdpWatts": 105,
    "integratedGraphics": true
  }
}

### Update the product created above (PUT replaces every field)
PUT {{baseUrl}}/admin/products/{{createdProduct.response.body.id}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "TEST-CPU-001",
  "name": "Test CPU 9000",
  "brand": "TestBrand",
  "description": "Price lowered",
  "price": 149.50,
  "stockQuantity": 10,
  "categorySlug": "processors",
  "productType": "CPU",
  "warrantyMonths": 36,
  "performanceScore": 70,
  "specs": {
    "kind": "CPU",
    "socket": "AM5",
    "cores": 8,
    "threads": 16,
    "baseClockGhz": 4.2,
    "boostClockGhz": 5.0,
    "tdpWatts": 105,
    "integratedGraphics": true
  }
}

### Hide it from the store (the public detail page then gives 404)
PATCH {{baseUrl}}/admin/products/{{createdProduct.response.body.id}}/active
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "active": false }

### Public view of the same product (404 while hidden)
GET {{baseUrl}}/products/{{createdProduct.response.body.id}}

### Show it again
PATCH {{baseUrl}}/admin/products/{{createdProduct.response.body.id}}/active
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "active": true }


########## Admin orders ##########
# Status moves: PLACED -> SHIPPED -> DELIVERED, or PLACED -> CANCELLED. Anything else gives 409.
# The requests below work on a fresh order, so the demo orders from V5 stay untouched.

### Customer places a fresh order to play with
# @name freshOrder
POST {{baseUrl}}/orders
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "items": [ { "productId": 2, "quantity": 1 } ],
  "shipping": { "fullName": "Lina Haddad", "address": "12 Hamra Street", "city": "Beirut", "phone": "+961 70 000 001" }
}

### All orders, newest first (add &status=PLACED, SHIPPED, DELIVERED or CANCELLED to filter)
GET {{baseUrl}}/admin/orders?size=5
Authorization: Bearer {{adminToken}}

### One order with its items and the customer who placed it
GET {{baseUrl}}/admin/orders/{{freshOrder.response.body.id}}
Authorization: Bearer {{adminToken}}

### Ship it (send "DELIVERED" next; "CANCELLED" on a PLACED order also restores stock and points)
PATCH {{baseUrl}}/admin/orders/{{freshOrder.response.body.id}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "SHIPPED" }

### Cancel after shipping (expect 409: only PLACED orders can be cancelled)
PATCH {{baseUrl}}/admin/orders/{{freshOrder.response.body.id}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "CANCELLED" }


########## Admin customers ##########

### All customers, newest first (admins are never listed)
GET {{baseUrl}}/admin/customers
Authorization: Bearer {{adminToken}}

### Search by email or full name, ignoring case
GET {{baseUrl}}/admin/customers?search=lina had
Authorization: Bearer {{adminToken}}

### One customer: profile, orders and points history (the customer logged in above)
GET {{baseUrl}}/admin/customers/{{customerLogin.response.body.user.id}}
Authorization: Bearer {{adminToken}}

### Give 10 points (send the next request too, so the demo balance goes back to what it was)
POST {{baseUrl}}/admin/customers/{{customerLogin.response.body.user.id}}/points
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "amount": 10 }

### Take the 10 points back
POST {{baseUrl}}/admin/customers/{{customerLogin.response.body.user.id}}/points
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "amount": -10 }

### Take more than the balance (expect 409: the balance can't go below 0)
POST {{baseUrl}}/admin/customers/{{customerLogin.response.body.user.id}}/points
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "amount": -100000 }


########## Admin products: requests that must fail ##########

### Wrong specs for the type (expect 400 on specs.kind)
POST {{baseUrl}}/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "TEST-CPU-002",
  "name": "CPU with GPU specs",
  "brand": "TestBrand",
  "price": 100,
  "stockQuantity": 1,
  "categorySlug": "processors",
  "productType": "CPU",
  "warrantyMonths": 12,
  "specs": { "kind": "GPU", "chipset": "X", "vramGb": 8, "lengthMm": 250, "tdpWatts": 200 }
}

### Air cooler with a radiator (expect 400 on specs.radiatorMm)
POST {{baseUrl}}/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "TEST-COOL-001",
  "name": "Bad air cooler",
  "brand": "TestBrand",
  "price": 30,
  "stockQuantity": 1,
  "categorySlug": "cpu-coolers",
  "productType": "COOLER",
  "warrantyMonths": 12,
  "specs": { "kind": "COOLER", "coolerType": "AIR", "heightMm": 150, "radiatorMm": 240, "supportedSockets": ["AM5"] }
}

### CPU in the Laptops category (expect 400 on categorySlug: each type has one category)
POST {{baseUrl}}/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "TEST-CPU-003",
  "name": "CPU in the wrong category",
  "brand": "TestBrand",
  "price": 100,
  "stockQuantity": 1,
  "categorySlug": "laptops",
  "productType": "CPU",
  "warrantyMonths": 12,
  "specs": { "kind": "CPU", "socket": "AM5", "cores": 8, "threads": 16, "baseClockGhz": 4.2, "tdpWatts": 105, "integratedGraphics": true }
}

### Customer token on an admin endpoint (expect 403)
GET {{baseUrl}}/admin/products
Authorization: Bearer {{customerToken}}

### No token (expect 401)
GET {{baseUrl}}/admin/products
